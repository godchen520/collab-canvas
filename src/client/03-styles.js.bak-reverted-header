// 面板样式（全部使用 --dsw-* 主题 token，换肤即跟随）
styles.insert(
  '.ccv-root{display:flex;flex-direction:column;height:100%;min-height:0;font-family:var(--font-ui,system-ui,sans-serif)}' +
  // ─── 顶部 bar（仿 WorkBuddy 文件 tab 风：左侧「📝 文件名 ×」激活态 tab + 右侧紧凑图标）───
  '.ccv-bar{display:flex;align-items:center;gap:6px;padding:5px 8px;border-bottom:1px solid var(--dsw-alias-border-l1,rgba(128,128,128,.25));flex-wrap:nowrap;overflow:visible;flex:0 0 auto}' +
  // 「激活 tab」风格的画布标题 —— 视觉等价 WorkBuddy 文件预览的那个 [📝 filename ×]
  '.ccv-tab-active{display:flex;align-items:center;gap:6px;padding:5px 6px 5px 10px;background:var(--dsw-alias-interactive-bg-active,rgba(59,130,246,.18));border:1px solid var(--dsw-alias-brand-primary,rgba(59,130,246,.45));border-radius:8px;max-width:280px;flex:0 1 auto;min-width:48px;font-size:13px;color:inherit;cursor:pointer;user-select:none}' +
  '.ccv-tab-active:hover{filter:brightness(1.08)}' +
  '.ccv-tab-active-icon{flex:0 0 auto;opacity:.85;font-size:13px;line-height:1}' +
  '.ccv-tab-active-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1 1 auto;min-width:0;font-weight:500}' +
  '.ccv-tab-active-toggle{flex:0 0 auto;background:transparent;border:none;color:inherit;cursor:pointer;font-size:11px;opacity:.7;padding:2px 5px;border-radius:4px;line-height:1}' +
  '.ccv-tab-active-toggle:hover{opacity:1;background:var(--dsw-alias-interactive-bg-hover,rgba(128,128,128,.2))}' +
  // spacer（让左 tab 和右按钮组之间留白）
  '.ccv-bar-spacer{flex:1 1 0%;min-width:8px}' +
  // 头部右区紧凑图标按钮（30×28）
  '.ccv-icon-btn{width:30px;height:28px;display:flex;align-items:center;justify-content:center;background:transparent;border:none;color:inherit;cursor:pointer;border-radius:6px;font-size:14px;font-family:inherit;line-height:1;flex:0 0 auto;padding:0}' +
  '.ccv-icon-btn:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(128,128,128,.15))}' +
  '.ccv-icon-btn[data-active="1"]{background:var(--dsw-alias-interactive-bg-active,rgba(59,130,246,.22))}' +
  '.ccv-icon-btn:disabled{opacity:.3;cursor:default}' +
  '.ccv-icon-btn:disabled:hover{background:transparent}' +
  // 分组分隔
  '.ccv-bar-sep{width:1px;height:18px;background:var(--dsw-alias-border-l1,rgba(128,128,128,.3));margin:0 4px;flex:0 0 auto}' +
  '.ccv-badge{font-size:10px;opacity:.45;margin-left:6px;user-select:none;flex:0 0 auto}' +
  // ─── 弹层（画布列表 / 新建表单 / 更多菜单） ───
  '.ccv-popover{position:fixed;z-index:9999;background:var(--dsw-specific-menu,var(--dsw-alias-bg-overlay,#fff));color:var(--dsw-alias-label-primary,#1a1a1a);border:1px solid var(--dsw-alias-border-l1,rgba(128,128,128,.4));border-radius:8px;box-shadow:0 6px 24px rgba(0,0,0,.25);padding:6px;min-width:220px;max-width:min(280px,80vw);max-height:60vh;overflow-y:auto}' +
  '.ccv-popover-head{font-size:10.5px;opacity:.55;user-select:none;padding:4px 8px;text-transform:uppercase;letter-spacing:.05em}' +
  '.ccv-popover-empty{padding:10px 12px;opacity:.6;font-size:13px;text-align:center}' +
  '.ccv-popover-item{display:flex;align-items:center;gap:6px;padding:6px 8px;border:none;background:transparent;color:inherit;cursor:pointer;font-size:13px;border-radius:5px;font-family:inherit;width:100%;text-align:left;box-sizing:border-box}' +
  '.ccv-popover-item:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(59,130,246,.18))}' +
  '.ccv-popover-item[data-active="1"]{font-weight:600;background:var(--dsw-alias-interactive-bg-active,rgba(59,130,246,.15))}' +
  '.ccv-popover-item-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1 1 auto;min-width:0;background:transparent;border:none;padding:0;color:inherit;text-align:left;font:inherit;cursor:pointer}' +
  '.ccv-popover-item-del{margin-left:auto;background:transparent;border:none;color:inherit;cursor:pointer;font-size:13px;opacity:.5;padding:2px 6px;border-radius:4px;flex:0 0 auto;line-height:1}' +
  '.ccv-popover-item-del:hover{opacity:1;background:var(--dsw-alias-interactive-bg-hover,rgba(239,68,68,.18))}' +
  '.ccv-popover-input{display:block;width:100%;padding:7px 10px;border:1px solid var(--dsw-alias-border-l2,rgba(128,128,128,.35));border-radius:6px;background:transparent;color:inherit;font-size:13px;font-family:inherit;box-sizing:border-box;outline:none}' +
  '.ccv-popover-input:focus{border-color:var(--dsw-alias-brand-primary,rgba(59,130,246,.55))}' +
  '.ccv-popover-btn{margin-top:6px;display:block;width:100%;padding:7px 10px;border:none;border-radius:6px;background:var(--dsw-alias-brand-primary,#3b82f6);color:#fff;cursor:pointer;font-size:13px;font-family:inherit}' +
  '.ccv-popover-btn:hover{filter:brightness(1.1)}' +
  '.ccv-popover-btn:disabled{opacity:.4;cursor:default}' +
  '.ccv-wysiwyg{flex:1;min-height:0;overflow-y:auto;padding:18px 24px;outline:none;font-size:14px;line-height:1.75;word-break:break-word}' +
  '.ccv-wysiwyg h1{font-size:1.6em;border-bottom:1px solid var(--dsw-alias-border-l2,rgba(128,128,128,.3));padding-bottom:.2em;margin:.5em 0 .4em}' +
  '.ccv-wysiwyg h2{font-size:1.35em;margin:.5em 0 .4em}' +
  '.ccv-wysiwyg h3{font-size:1.18em;margin:.5em 0 .4em}' +
  '.ccv-wysiwyg blockquote{border-left:3px solid var(--dsw-alias-border-l2,rgba(128,128,128,.4));margin:.5em 0;padding:2px 12px;opacity:.85}' +
  '.ccv-wysiwyg pre{background:var(--dsw-alias-markdown-code-block,rgba(128,128,128,.12));padding:10px 12px;border-radius:6px;overflow-x:auto;white-space:pre-wrap}' +
  '.ccv-wysiwyg code{background:var(--dsw-alias-markdown-inline-code,rgba(128,128,128,.16));padding:1px 4px;border-radius:3px;font-family:var(--font-mono,ui-monospace,Menlo,monospace);font-size:.95em}' +
  '.ccv-wysiwyg pre code{background:transparent;padding:0}' +
  '.ccv-wysiwyg ul,.ccv-wysiwyg ol{padding-left:1.6em}' +
  '.ccv-wysiwyg a{color:var(--dsw-alias-brand-primary,#3b82f6)}' +
  '.ccv-wysiwyg:empty:before{content:attr(data-placeholder);opacity:.35}' +
  '.ccv-menu{position:fixed;z-index:9999;background:var(--dsw-specific-menu,var(--dsw-alias-bg-overlay,#ffffff));color:var(--dsw-alias-label-primary,#1a1a1a);border:1px solid var(--dsw-alias-border-l1,rgba(128,128,128,.4));border-radius:8px;box-shadow:0 6px 24px rgba(0,0,0,.25);padding:4px;min-width:150px;max-width:min(260px,80vw);max-height:60vh;overflow-y:auto}' +
  '.ccv-menu[data-delayed="1"]{opacity:0;pointer-events:none;animation:ccvMenuShow .15s ease 1s forwards}' +
  '@keyframes ccvMenuShow{to{opacity:1;pointer-events:auto}}' +
  '.ccv-selbar{position:fixed;z-index:9998;display:flex;align-items:center;gap:2px;background:var(--dsw-specific-menu,var(--dsw-alias-bg-overlay,#ffffff));color:var(--dsw-alias-label-primary,#1a1a1a);border:1px solid var(--dsw-alias-border-l1,rgba(128,128,128,.4));border-radius:8px;box-shadow:0 6px 24px rgba(0,0,0,.25);padding:2px 6px;user-select:none;-webkit-user-select:none;touch-action:manipulation}' +
  '.ccv-selbar button{border:none;background:transparent;color:inherit;cursor:pointer;font-size:13px;min-width:30px;height:30px;border-radius:6px;font-family:inherit}' +
  '.ccv-selbar button:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(128,128,128,.2))}' +
  '.ccv-selbar button[data-active="1"]{background:rgba(59,130,246,.22);color:var(--dsw-alias-brand-primary,#3b82f6)}' +
  '.ccv-selbar .ccv-minibar-more{font-size:16px;letter-spacing:1px}' +
  '.ccv-menu-head{display:flex;align-items:center;justify-content:space-between;padding:2px 6px 4px 10px;border-bottom:1px solid var(--dsw-alias-border-l1,rgba(128,128,128,.3));margin-bottom:4px}' +
  '.ccv-menu-title{font-size:11px;opacity:.55;user-select:none}' +
  '.ccv-menu-close{border:none;background:transparent;color:inherit;cursor:pointer;font-size:14px;padding:2px 6px;border-radius:4px;opacity:.7}' +
  '.ccv-menu-close:hover{opacity:1;background:var(--dsw-alias-interactive-bg-hover,rgba(128,128,128,.2))}' +
  '.ccv-menu-item{display:block;width:100%;text-align:left;padding:6px 12px;border:none;background:transparent;color:inherit;cursor:pointer;font-size:13px;border-radius:5px;font-family:inherit}' +
  '.ccv-menu-item:hover{background:var(--dsw-alias-interactive-bg-hover,rgba(59,130,246,.18))}' +
  '.ccv-menu-sep{height:1px;background:var(--dsw-alias-border-l1,rgba(128,128,128,.3));margin:4px 6px}' +
  '.ccv-status{padding:4px 12px;border-top:1px solid var(--dsw-alias-border-l1,rgba(128,128,128,.25));font-size:11px;opacity:.75;min-height:18px;font-family:var(--font-ui,system-ui,sans-serif)}' +
  '.ccv-status[data-kind="error"]{color:var(--dsw-alias-state-error-primary,#ef4444);opacity:1}'
)
